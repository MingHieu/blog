---
import type { CollectionEntry } from 'astro:content';

interface Props {
  chapters: CollectionEntry<'mobile'>[];
  currentId: string;
}

const { chapters, currentId } = Astro.props;
const currentChapterIndex = chapters.findIndex((c) => c.id === currentId);
const activeIndexDisplay =
  currentChapterIndex !== -1 ? currentChapterIndex + 1 : 1;
---

<button
  id="sidebar-toggle-btn"
  class="sidebar-toggle-btn"
  aria-label="Toggle Chapters List"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="3" y1="12" x2="21" y2="12"></line>
    <line x1="3" y1="6" x2="21" y2="6"></line>
    <line x1="3" y1="18" x2="21" y2="18"></line>
  </svg>
  <span>Chapters {activeIndexDisplay}/{chapters.length}</span>
</button>

<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<aside class="sidebar-container" id="chapter-sidebar">
  <div class="sidebar-header">
    <span class="series-tag">Series</span>
    <h3 class="sidebar-title">{chapters[0]?.data.title || ''}</h3>
    <button
      id="sidebar-close-btn"
      class="sidebar-close-btn"
      aria-label="Close Sidebar"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav">
    <ul class="chapter-list">
      {
        chapters.map((chapter, index) => {
          const isActive = chapter.id === currentId;
          const cleanTitle =
            chapter.data.title.split(':').pop()?.trim() || chapter.data.title;
          return (
            <li class={`chapter-item ${isActive ? 'active' : ''}`}>
              <a
                href={`${import.meta.env.BASE_URL}/mobile/${chapter.id}`}
                class="chapter-link"
              >
                <span class="chapter-num">
                  {String(chapter.data.order ?? index).padStart(2, '0')}
                </span>
                <span class="chapter-title-text">{cleanTitle}</span>
                {isActive && <span class="active-dot" />}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>

<script>
  const toggleBtn = document.getElementById('sidebar-toggle-btn');
  const sidebar = document.getElementById('chapter-sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');
  const closeBtn = document.getElementById('sidebar-close-btn');

  if (sidebar) {
    const scrollActiveIntoView = (smooth = false) => {
      const activeItem = sidebar.querySelector('.chapter-item.active');
      if (activeItem) {
        const containerHeight = sidebar.clientHeight;
        const itemTop = activeItem.offsetTop;
        const itemHeight = activeItem.clientHeight;
        const targetScroll = itemTop - containerHeight / 2 + itemHeight / 2;

        if (smooth) {
          sidebar.style.scrollBehavior = 'smooth';
          sidebar.scrollTop = targetScroll;
        } else {
          sidebar.style.scrollBehavior = 'auto';
          sidebar.scrollTop = targetScroll;
        }
      }
    };

    // Scroll to active chapter on load (smooth on desktop, instant on mobile)
    const isDesktop = window.innerWidth >= 1024;
    setTimeout(() => scrollActiveIntoView(isDesktop), 100);

    if (toggleBtn && backdrop) {
      const toggleSidebar = () => {
        const isOpen = sidebar.classList.toggle('open');
        backdrop.classList.toggle('visible', isOpen);
        document.body.classList.toggle('sidebar-open', isOpen);
        if (isOpen) {
          setTimeout(() => scrollActiveIntoView(true), 350);
        }
      };

      const closeSidebar = () => {
        sidebar.classList.remove('open');
        backdrop.classList.remove('visible');
        document.body.classList.remove('sidebar-open');
      };

      toggleBtn.addEventListener('click', toggleSidebar);
      backdrop.addEventListener('click', closeSidebar);
      if (closeBtn) {
        closeBtn.addEventListener('click', closeSidebar);
      }
    }
  }
</script>

<style>
  /* Floating Action Button for mobile */
  .sidebar-toggle-btn {
    display: none;
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 99;
    background: var(--accent);
    color: #ffffff;
    border: none;
    padding: 0.8rem 1.4rem;
    border-radius: 2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-toggle-btn:hover {
    transform: translateX(-50%) translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
  }

  /* Backdrop */
  .sidebar-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .sidebar-backdrop.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Sidebar Container */
  .sidebar-container {
    width: 100%;
    height: calc(100vh - 8rem);
    position: sticky;
    top: 4rem;
    padding-right: 1.5rem;
    border-right: 1px solid var(--border-color);
    overflow-y: auto;

    /* Firefox scrollbar customization */
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;
  }

  /* Custom Webkit Scrollbar */
  .sidebar-container::-webkit-scrollbar {
    width: 6px;
  }

  .sidebar-container::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-container::-webkit-scrollbar-thumb {
    background-color: var(--border-color);
    border-radius: 3px;
    border: 1px solid transparent;
    background-clip: padding-box;
  }

  .sidebar-container::-webkit-scrollbar-thumb:hover {
    background-color: var(--text-dim);
  }

  .sidebar-header {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-close-btn {
    display: none;
  }

  .series-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    font-weight: 700;
  }

  .sidebar-title {
    font-size: 1.4rem;
    line-height: 1.3;
    margin: 0;
    font-weight: 700;
    color: var(--text-color);
  }

  .sidebar-nav {
    margin-top: 1.5rem;
  }

  .chapter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .chapter-item {
    border-radius: 0.6rem;
    transition:
      transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.2s ease;
  }

  .chapter-link {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: var(--text-dim);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 0.6rem;
    transition: all 0.15s ease;
  }

  .chapter-item:hover {
    background: var(--code-bg);
    transform: translateX(4px);
  }

  .chapter-item:hover .chapter-link {
    color: var(--text-color);
  }

  .chapter-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--accent);
    opacity: 0.8;
  }

  /* Active state */
  .chapter-item.active {
    background: var(--selection-bg);
    border-left: 3px solid var(--accent);
    border-radius: 0 0.6rem 0.6rem 0;
  }

  .chapter-item.active .chapter-link {
    color: var(--accent);
    font-weight: 700;
  }

  .chapter-item.active .chapter-num {
    opacity: 1;
  }

  /* Pulsing active dot */
  .active-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent);
    animation: pulse-dot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      transform: scale(0.8);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.3);
      opacity: 1;
      box-shadow: 0 0 12px var(--accent);
    }
  }

  /* Responsive rules for sidebar */
  @media (max-width: 1023px) {
    .sidebar-toggle-btn {
      display: flex;
    }

    .sidebar-backdrop {
      display: block;
    }

    .sidebar-container {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      max-height: 100vh;
      width: 300px;
      background: var(--bg-color);
      z-index: 101;
      padding: 2.5rem;
      border-right: 1px solid var(--border-color);
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
    }

    .sidebar-container.open {
      transform: translateX(0);
    }

    .sidebar-header {
      position: relative;
      padding-right: 2.5rem;
    }

    .sidebar-close-btn {
      display: flex;
      position: absolute;
      top: 0;
      right: 0;
      background: transparent;
      border: none;
      color: var(--text-dim);
      cursor: pointer;
      padding: 0.4rem;
      border-radius: 0.4rem;
      transition: all 0.2s ease;
    }

    .sidebar-close-btn:hover {
      background: var(--code-bg);
      color: var(--text-color);
    }
  }
</style>
