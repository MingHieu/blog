---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
	const allChapters = await getCollection('mobile');
	const categories = [...new Set(allChapters.map(c => c.data.category || 'other'))];
	
	return categories.flatMap(cat => {
		const categoryChapters = allChapters.filter(c => (c.data.category || 'other') === cat);
		
		const seriesMap = categoryChapters.reduce((acc, chapter) => {
			const parts = chapter.id.split('/');
			if (parts.length < 2) return acc;
			
			const seriesId = parts[0];
			if (!acc[seriesId]) {
				acc[seriesId] = {
					id: seriesId,
					chapters: [],
					title: '',
					category: cat
				};
			}
			acc[seriesId].chapters.push(chapter);
			return acc;
		}, {});
		
		const processedSeries = Object.values(seriesMap).map(series => {
			series.chapters.sort((a, b) => a.data.order - b.data.order);
			const firstChapter = series.chapters[0];
			
			const displayTitle = series.id
				.split('-')
				.map(word => word.charAt(0).toUpperCase() + word.slice(1))
				.join(' ');
			
			return {
				id: series.id,
				title: displayTitle,
				description: firstChapter?.data.description || '',
				firstChapterSlug: firstChapter?.id || '',
				chapterCount: series.chapters.length
			};
		});
		
		return paginate(processedSeries, {
			params: { category: cat },
			pageSize: 5
		});
	});
}

const { category } = Astro.params;
const { page } = Astro.props;

const categoryDisplayName = category.charAt(0).toUpperCase() + category.slice(1);
---

<Layout title={`${categoryDisplayName} Explorations - Page ${page.currentPage} | MH / LAB`} description={`Engineering series and tutorials about ${categoryDisplayName}.`}>
	<div class="category-page">
		<header class="category-header">
			<a href={import.meta.env.BASE_URL} class="back-link">
				<span class="arrow">&larr;</span> Back to Home
			</a>
			<div class="category-tag">Category</div>
			<h1>{categoryDisplayName}</h1>
			<p class="category-desc">Engineering series, research, and tutorials about {categoryDisplayName}.</p>
		</header>

		<div class="series-list">
			{page.data.length === 0 ? (
				<p class="no-content">No content available in this category yet. Stay tuned!</p>
			) : (
				page.data.map((series) => (
					<div class="series-row">
						<div class="series-info">
							<h3>
								<a href={`${import.meta.env.BASE_URL}/mobile/${series.firstChapterSlug}`}>{series.title}</a>
							</h3>
							<p>{series.description}</p>
						</div>
						<div class="series-meta">
							<span class="chapter-count">{series.chapterCount} articles</span>
						</div>
					</div>
				))
			)}
		</div>

		{page.lastPage > 1 && (
			<nav class="pagination-nav">
				{page.url.prev ? (
					<a href={page.url.prev} class="nav-btn">
						&larr; Prev
					</a>
				) : (
					<span class="nav-btn disabled">&larr; Prev</span>
				)}
				
				<span class="page-info">
					Page {page.currentPage} of {page.lastPage}
				</span>
				
				{page.url.next ? (
					<a href={page.url.next} class="nav-btn">
						Next &rarr;
					</a>
				) : (
					<span class="nav-btn disabled">Next &rarr;</span>
				)}
			</nav>
		)}
	</div>
</Layout>

<style>
	.category-page {
		padding-bottom: 8rem;
	}

	.category-header {
		margin-bottom: 4rem;
		padding-bottom: 2rem;
		border-bottom: 2px solid var(--border-color);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		color: var(--text-dim);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 2.5rem;
		transition: color 0.2s ease;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.back-link .arrow {
		margin-right: 0.5rem;
		transition: transform 0.2s ease;
	}

	.back-link:hover .arrow {
		transform: translateX(-4px);
	}

	.category-tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--accent);
		margin-bottom: 0.75rem;
		font-weight: 700;
	}

	h1 {
		font-size: 3.5rem;
		line-height: 1.15;
		margin: 0;
		letter-spacing: -0.03em;
		border-bottom: none;
	}

	.category-desc {
		font-size: 1.25rem;
		color: var(--text-dim);
		margin-top: 1rem;
		max-width: 600px;
		line-height: 1.5;
	}

	.series-list {
		display: flex;
		flex-direction: column;
	}

	.series-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--border-color);
		transition: transform 0.2s ease;
	}

	.series-row:hover {
		transform: translateX(10px);
	}

	.series-row:last-child {
		border-bottom: none;
	}

	.series-info h3 {
		margin: 0 0 0.75rem;
		font-size: 1.8rem;
		font-weight: 700;
	}

	.series-info h3 a {
		text-decoration: none;
		color: var(--text-color);
		transition: color 0.2s;
	}

	.series-info h3 a:hover {
		color: var(--accent);
	}

	.series-info p {
		font-size: 1.1rem;
		color: var(--text-dim);
		margin-bottom: 0;
		max-width: 550px;
		line-height: 1.6;
	}

	.series-meta {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		color: var(--text-dim);
		text-align: right;
		padding-top: 0.8rem;
		font-weight: 600;
	}

	.no-content {
		font-family: 'JetBrains Mono', monospace;
		font-size: 1rem;
		color: var(--text-dim);
		font-style: italic;
	}

	.pagination-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
	}

	.page-info {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		color: var(--text-dim);
		font-weight: 600;
	}

	.nav-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.6rem 1.2rem;
		border-radius: 0.5rem;
		background: var(--code-bg);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		text-decoration: none;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.8rem;
		font-weight: 700;
		transition: all 0.2s ease;
	}

	.nav-btn:hover:not(.disabled) {
		background: var(--selection-bg);
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-1px);
	}

	.nav-btn.disabled {
		opacity: 0.4;
		cursor: not-allowed;
		pointer-events: none;
	}

	@media (max-width: 768px) {
		h1 { font-size: 2.75rem; }
		.series-row { flex-direction: column; }
		.series-row:hover { transform: none; }
		.series-meta { text-align: left; margin-top: 1rem; padding-top: 0; }
	}
</style>
