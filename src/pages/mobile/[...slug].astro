---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ChapterSidebar from '../../components/ChapterSidebar.astro';

export async function getStaticPaths() {
	const chapters = await getCollection('mobile');
	return chapters.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const mobileId = entry.id.split('/')[0];
const allChapters = await getCollection('mobile');
const sortedChapters = allChapters
	.filter(c => c.id.startsWith(mobileId + '/'))
	.sort((a, b) => a.data.order - b.data.order);

const currentIndex = sortedChapters.findIndex((c) => c.id === entry.id);
const prev = currentIndex > 0 ? sortedChapters[currentIndex - 1] : null;
const next = currentIndex < sortedChapters.length - 1 ? sortedChapters[currentIndex + 1] : null;

const seriesTitle = mobileId
	.split('-')
	.map(word => word.charAt(0).toUpperCase() + word.slice(1))
	.join(' ');
---

<Layout title={`${entry.data.title} | MH / LAB`} description={entry.data.description} ogImage={entry.data.image}>
	<ChapterSidebar slot="sidebar" chapters={sortedChapters} currentId={entry.id} seriesTitle={seriesTitle} />
	<article class="post">
		<header>
			<div class="meta-line">
				<a class="breadcrumb-link" href={`${import.meta.env.BASE_URL}/category/${entry.data.category}`}>{entry.data.category}</a>
				<span class="sep">/</span>
				<a class="breadcrumb-link" href={`${import.meta.env.BASE_URL}/mobile/${sortedChapters[0].id}`}>{seriesTitle}</a>
				<span class="sep">/</span>
				<span class="ord">{String(entry.data.order || 0).padStart(2, '0')}</span>
			</div>
			<h1>{entry.data.title}</h1>
			<p class="lede">{entry.data.description}</p>
		</header>
		
		<div class="content">
			<Content />
		</div>

		<nav class="pagination">
			<div class="pn-item">
				{prev && (
					<a href={`${import.meta.env.BASE_URL}/mobile/${prev.id}`}>
						<span class="dir">Prev</span>
						<span class="t">{String(prev.data.order || 0).padStart(2, '0')}. {prev.data.title.split(':').pop()?.trim() || prev.data.title}</span>
					</a>
				)}
			</div>
			
			<div class="pn-item">
				{next && (
					<a href={`${import.meta.env.BASE_URL}/mobile/${next.id}`}>
						<span class="dir">Next</span>
						<span class="t">{String(next.data.order || 0).padStart(2, '0')}. {next.data.title.split(':').pop()?.trim() || next.data.title}</span>
					</a>
				)}
			</div>
		</nav>
	</article>
</Layout>

<style>
	.post {
		padding-bottom: 3rem;
	}

	header {
		margin-bottom: 6rem;
		padding-bottom: 4rem;
		border-bottom: 2px solid var(--border-color);
	}

	.meta-line {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 1.5rem;
		letter-spacing: 0.1em;
		font-weight: 700;
	}

	.breadcrumb-link,
	.breadcrumb-link:visited {
		text-decoration: none;
		color: var(--accent);
		transition: opacity 0.2s ease;
	}

	.breadcrumb-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
		color: var(--accent);
		opacity: 0.8;
	}

	.sep {
		margin: 0 0.5rem;
		opacity: 0.4;
		color: var(--text-dim);
	}

	h1 {
		font-size: 3.5rem;
		line-height: 1.2;
		margin: 0 0 1.5rem;
		letter-spacing: -0.03em;
	}

	.lede {
		font-size: 1.35rem;
		color: var(--text-dim);
		line-height: 1.6;
		font-weight: 500;
		max-width: 700px;
	}

	.pagination {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-top: 4rem;
		padding-top: 3rem;
		border-top: 2px solid var(--border-color);
	}

	.pn-item a {
		text-decoration: none;
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border-radius: 1rem;
		background: var(--code-bg);
		transition: all 0.2s ease;
	}

	.pn-item a:hover {
		background: var(--selection-bg);
		transform: translateY(-5px);
	}

	.pn-item .dir {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent);
		margin-bottom: 0.5rem;
		font-weight: 700;
	}

	.pn-item .t {
		font-size: 1.25rem;
		color: var(--text-color);
		font-weight: 700;
		line-height: 1.3;
	}

	.pn-item:last-child {
		text-align: right;
	}

	@media (max-width: 768px) {
		h1 { font-size: 2.5rem; }
		.pagination { grid-template-columns: 1fr; gap: 1.5rem; }
	}
</style>
